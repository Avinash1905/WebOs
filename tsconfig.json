{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "baseUrl": ".",
    "paths": {
      "@core/*": ["core/*"],
      "@applications/*": ["applications/*"],
      "@backend/*": ["backend/*"],
      "@database/*": ["database/*"],
      "@src/*": ["src/*"]
    }
  },
  "include": ["src", "core", "applications", "backend", "database", "scripts", "vite.config.ts"]
}
